{
  "name": "chroniko",
  "version": "0.2.1",
  "description": "Render historical events on a single zoomable time axis. Plain HTML, CSS and JavaScript, no dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/chroniko.min.js",
  "exports": {
    ".": "./dist/chroniko.min.js",
    "./chroniko.css": "./dist/chroniko.min.css"
  },
  "scripts": {
    "start": "node scripts/serve.js",
    "build": "webpack",
    "prepack": "npm run build"
  },
  "keywords": [
    "timeline",
    "history",
    "events",
    "chronology"
  ],
  "author": "Ying Kit Yuen <yingkityuen@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ykyuen/chroniko.git"
  },
  "homepage": "https://github.com/ykyuen/chroniko#readme",
  "bugs": {
    "url": "https://github.com/ykyuen/chroniko/issues"
  },
  "sideEffects": [
    "*.css"
  ],
  "devDependencies": {
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "mini-css-extract-plugin": "^2.10.2",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-remove-empty-scripts": "^1.1.1"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ]
}
